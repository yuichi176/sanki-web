{
  "name": "sanki-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.15.0",
    "pnpm": "11.0.9"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir .ssr && node scripts/prerender.mjs",
    "build:github-pages": "VITE_BASE_PATH=/sanki-web/ pnpm build",
    "preview": "vite preview",
    "lint": "eslint 'src/**/*.{js,ts,jsx,tsx}' --cache",
    "lint:fix": "eslint 'src/**/*.{js,ts,jsx,tsx}' --fix --cache",
    "typecheck": "tsc --noEmit",
    "format": "prettier 'src/**/*.{js,ts,jsx,tsx}' --check",
    "format:fix": "prettier 'src/**/*.{js,ts,jsx,tsx}' --write",
    "test": "echo 'test complete!'"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "eslint-plugin-tailwindcss": "4.2.0",
    "globals": "17.8.0",
    "lefthook": "2.1.10",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0"
  }
}
